{
  "sourceLanguage": "en",
  "strings": {
    "%lld clients": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld clientes"
          }
        }
      }
    },
    "1 client": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "1 cliente"
          }
        }
      }
    },
    "A code is valid for 2 minutes. Show a new one and scan it with the iPhone.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un código vale 2 minutos. Muestra uno nuevo y escanéalo con el iPhone."
          }
        }
      }
    },
    "Cancel": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancelar"
          }
        }
      }
    },
    "Close": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cerrar"
          }
        }
      }
    },
    "Connected": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conectado"
          }
        }
      }
    },
    "Couldn't access the Keychain. Pairing won't be saved.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo acceder al llavero. El emparejamiento no se guardará."
          }
        }
      }
    },
    "Couldn't change the login item.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo cambiar el ítem de inicio."
          }
        }
      }
    },
    "Couldn't generate the QR code.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo generar el código QR."
          }
        }
      }
    },
    "Couldn't save the pairing in the Keychain.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo guardar el emparejamiento en el llavero."
          }
        }
      }
    },
    "Done": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Listo"
          }
        }
      }
    },
    "Expires in %@": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vence en %@"
          }
        }
      }
    },
    "Input": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Entrada"
          }
        }
      }
    },
    "It will connect automatically from now on. You can revoke it from the menu.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desde ahora se conectará solo. Puedes revocarlo desde el menú."
          }
        }
      }
    },
    "LevelDeck": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "LevelDeck"
          }
        }
      }
    },
    "Mute": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Silenciar"
          }
        }
      }
    },
    "No device": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin dispositivo"
          }
        }
      }
    },
    "No paired devices yet.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todavía no hay dispositivos emparejados."
          }
        }
      }
    },
    "Not connected": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No conectado"
          }
        }
      }
    },
    "Open LevelDeck on the iPhone, tap Pair and point the camera at this code. The key never leaves this screen.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre LevelDeck en el iPhone, toca Emparejar y apunta la cámara a este código. La clave nunca sale de esta pantalla."
          }
        }
      }
    },
    "Open Login Items Settings…": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abrir ajustes de ítems de inicio…"
          }
        }
      }
    },
    "Open at Login": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abrir al iniciar sesión"
          }
        }
      }
    },
    "Output": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Salida"
          }
        }
      }
    },
    "Pair New Device…": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Emparejar nuevo dispositivo…"
          }
        }
      }
    },
    "Pair a New Device": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Emparejar un dispositivo nuevo"
          }
        }
      }
    },
    "Paired devices": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dispositivos emparejados"
          }
        }
      }
    },
    "Pairing QR code": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Código QR de emparejamiento"
          }
        }
      }
    },
    "Protocol v%lld": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Protocolo v%lld"
          }
        }
      }
    },
    "Quit": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Salir"
          }
        }
      }
    },
    "Revoke": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Revocar"
          }
        }
      }
    },
    "Revoke “%@”": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Revocar “%@”"
          }
        }
      }
    },
    "Scan this code with LevelDeck on your iPhone.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escanea este código con LevelDeck en tu iPhone."
          }
        }
      }
    },
    "Service stopped": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Servicio detenido"
          }
        }
      }
    },
    "Show a New Code": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar un código nuevo"
          }
        }
      }
    },
    "Starting service…": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Iniciando servicio…"
          }
        }
      }
    },
    "The code expired.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El código venció."
          }
        }
      }
    },
    "The iPhone was refused so it doesn't keep a key the Mac won't remember. Fix Keychain access and show a new code.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se rechazó al iPhone para que no se quede con una clave que la Mac no recordará. Arregla el acceso al llavero y muestra un código nuevo."
          }
        }
      }
    },
    "The network service couldn't start.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo iniciar el servicio de red."
          }
        }
      }
    },
    "This device doesn't allow changing the volume or muting.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo no permite cambiar el volumen ni silenciar."
          }
        }
      }
    },
    "This device doesn't allow changing the volume.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo no permite cambiar el volumen."
          }
        }
      }
    },
    "This device doesn't allow muting.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo no permite silenciar."
          }
        }
      }
    },
    "Unmute": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activar sonido"
          }
        }
      }
    },
    "Waiting for the network…": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esperando la red…"
          }
        }
      }
    },
    "macOS needs your approval to open LevelDeck Agent at login.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS necesita tu aprobación para abrir LevelDeck Agent al iniciar sesión."
          }
        }
      }
    },
    "“%@” is now paired.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” quedó emparejado."
          }
        }
      }
    },
    "“%@” · port %lld · %@": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” · puerto %lld · %@"
          }
        }
      }
    }
  },
  "version": "1.0"
}
